+
+    response = await client.get(
+        f"{v2_project_url}/memory/{uri}",
+        params={"depth": 3, "max_related": 100, "exclude_relation_types": ["connected_to"]},
+    )
+    assert response.status_code == 200
+    assert related(response.json()) == ({"connects_to"}, {"Connected Entity 1"})
+
+    response = await client.get(
+        f"{v2_project_url}/memory/{uri}", params={"exclude_relation_types": ["connects_to"]}
+    )
