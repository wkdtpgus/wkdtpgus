+):
+    """Relation filters are query parameters on the context endpoint."""
+    uri = f"{test_project.name}/test/root"
+
+    def related(data: dict[str, Any]) -> tuple[set[str], set[str]]:
+        items = data["results"][0]["related_results"]
+        return (
